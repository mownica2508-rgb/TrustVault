APP_NAME=TrustVault
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://trustvault:change-me@127.0.0.1:3306/trustvault?charset=utf8mb4
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
STORAGE_DIR=private_storage
MAX_UPLOAD_BYTES=10485760
